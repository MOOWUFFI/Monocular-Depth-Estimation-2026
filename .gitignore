# regenerable from a checkpoint and is dropped by default.
approaches/*/results/*/predictions/
approaches/*/results/*/submission.csv
approaches/*/results/*/checkpoints/latest.pth

# Benchmark data + outputs are large / machine-specific.
data/benchmarks/
results/benchmarks/
